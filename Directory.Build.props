<Project>

  <!--
    Shared MSBuild properties for every project in the mojoCAD solution.
    See docs/ARCHITECTURE.md and docs/BUILD.md for the rationale behind the
    multi-targeting and AutoCAD reference strategy.
  -->

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>en-US</NeutralLanguage>

    <Product>mojoCAD</Product>
    <Company>mojoCAD</Company>
    <Authors>mojoCAD</Authors>
    <Copyright>Copyright © mojoCAD</Copyright>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <!--
      AutoCAD loads managed plugins into its own AppDomain. We never want our
      build to drag AutoCAD's own assemblies (acmgd, acdbmgd, accoremgd,
      AdWindows) into the output folder - they are provided by the running
      AutoCAD process. That exclusion is done per-package on the AutoCAD
      references via ExcludeAssets=runtime (see MojoCad.Acad/Plugin .csproj).

      We DO want every OTHER runtime dependency (System.Text.Json,
      CommunityToolkit.Mvvm, Microsoft.Bcl.AsyncInterfaces, the project DLLs)
      flattened into the plugin's output folder, because AutoCAD loads the
      plugin DLL and probes its folder - there is no host deps.json resolution.
      So CopyLocalLockFileAssemblies is TRUE: the full runtime closure (minus
      the runtime-excluded AutoCAD assemblies) lands next to MojoCad.Plugin.dll
      and the bundle is self-contained.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    AutoCAD 2025+ runs on .NET 8; AutoCAD 2021-2024 runs on .NET Framework 4.8.
    The managed ObjectARX API surface we use is identical across both, so we
    multi-target and ship a single codebase. Individual csproj files choose
    their <TargetFrameworks> (UI/AutoCAD projects need the -windows TFM for WPF).
  -->
  <PropertyGroup>
    <MojoNet8>net8.0-windows</MojoNet8>
    <MojoNet48>net48</MojoNet48>
  </PropertyGroup>

</Project>
