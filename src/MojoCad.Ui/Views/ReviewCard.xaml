<UserControl x:Class="MojoCad.Ui.Views.ReviewCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MojoCad.Ui.Converters"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignWidth="340">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToCollapsedConverter x:Key="NullToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:CategoryToBrushConverter x:Key="CatToBrush" />
        <conv:SeverityToBrushConverter x:Key="SevToBrush" />
    </UserControl.Resources>

    <Border Style="{DynamicResource CardBorder}" Padding="0">
        <StackPanel>
            <!-- ===== Header: summary + trustworthy computed counts ===== -->
            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="10,10,0,0" Padding="14,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Proposed changes" FontWeight="SemiBold" FontSize="14" />
                        <Border Style="{DynamicResource Badge}" Background="{DynamicResource Brush.Danger}" Margin="8,0,0,0"
                                Visibility="{Binding ChangeSet.HasBlocking, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="REVIEW BLOCKED" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ChangeSet.Summary}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,8" />

                    <!-- count chips: ADD / MODIFY / ERASE / ORG -->
                    <WrapPanel>
                        <Border Style="{DynamicResource Badge}" Background="{DynamicResource Brush.Additive}" Margin="0,0,6,4"
                                Visibility="{Binding ChangeSet.AdditiveCount, Converter={StaticResource CountToVis}}">
                            <TextBlock FontSize="11" Foreground="#FF0B1F0E">
                                <Run Text="+"/><Run Text="{Binding ChangeSet.AdditiveCount, Mode=OneWay}"/><Run Text=" new"/>
                            </TextBlock>
                        </Border>
                        <Border Style="{DynamicResource Badge}" Background="{DynamicResource Brush.Modify}" Margin="0,0,6,4"
                                Visibility="{Binding ChangeSet.ModifyCount, Converter={StaticResource CountToVis}}">
                            <TextBlock FontSize="11" Foreground="#FF231703">
                                <Run Text="~"/><Run Text="{Binding ChangeSet.ModifyCount, Mode=OneWay}"/><Run Text=" modified"/>
                            </TextBlock>
                        </Border>
                        <Border Style="{DynamicResource Badge}" Background="{DynamicResource Brush.Erase}" Margin="0,0,6,4"
                                Visibility="{Binding ChangeSet.EraseCount, Converter={StaticResource CountToVis}}">
                            <TextBlock FontSize="11" Foreground="White">
                                <Run Text="−"/><Run Text="{Binding ChangeSet.EraseCount, Mode=OneWay}"/><Run Text=" erased"/>
                            </TextBlock>
                        </Border>
                        <Border Style="{DynamicResource Badge}" Background="{DynamicResource Brush.Organizational}" Margin="0,0,6,4"
                                Visibility="{Binding ChangeSet.OrganizationalCount, Converter={StaticResource CountToVis}}">
                            <TextBlock FontSize="11" Foreground="#FF13171D">
                                <Run Text="{Binding ChangeSet.OrganizationalCount, Mode=OneWay}"/><Run Text=" org"/>
                            </TextBlock>
                        </Border>
                    </WrapPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}">
                        <Run Text="Layers: "/><Run Text="{Binding ChangeSet.LayersTouched, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ===== Op rows ===== -->
            <ItemsControl ItemsSource="{Binding ChangeSet.Ops}" Margin="6,6,6,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="rowRoot" CornerRadius="6" Padding="8,7" Margin="0,2"
                                Background="Transparent" MouseEnter="Row_MouseEnter">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- accept tick (disabled & off for Blocking) -->
                                <CheckBox Grid.Column="0" Style="{DynamicResource MojoCheckBox}" VerticalAlignment="Top"
                                          IsChecked="{Binding IsAccepted, Mode=TwoWay}"
                                          IsEnabled="{Binding CanAccept}"
                                          Margin="0,1,8,0" />

                                <!-- category colour stripe -->
                                <Border Grid.Column="1" Width="3" CornerRadius="2" Margin="0,1,8,1"
                                        Background="{Binding Category, Converter={StaticResource CatToBrush}}" />

                                <!-- description + badges + lint -->
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{DynamicResource Badge}"
                                                Background="{Binding Category, Converter={StaticResource CatToBrush}}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="9" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Style="{DynamicResource Badge}"
                                                Background="{Binding Severity, Converter={StaticResource SevToBrush}}"
                                                Visibility="{Binding ShowSeverity, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SeverityLabel}" FontSize="9" Foreground="White" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="230" />
                                    <TextBlock Text="{Binding Layer}" FontSize="10" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,2,0,0" />

                                    <!-- lint finding -->
                                    <Border Background="{DynamicResource Brush.Surface}" CornerRadius="4" Padding="6,4" Margin="0,5,0,0"
                                            Visibility="{Binding HasLint, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding LintMessage}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{Binding Severity, Converter={StaticResource SevToBrush}}" />
                                            <TextBlock Text="{Binding LintHint}" FontSize="10" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Brush.TextFaint}" Margin="0,2,0,0"
                                                       Visibility="{Binding LintHint, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- apply outcome -->
                                    <TextBlock Text="✓ applied" FontSize="10" Foreground="{DynamicResource Brush.Ok}" Margin="0,3,0,0"
                                               Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Danger}" Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                                        <Run Text="✗ failed: "/><Run Text="{Binding FailureReason, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- zoom-to affordance -->
                                <Button Grid.Column="3" Content="⤢" Style="{DynamicResource IconButton}" Width="26" Height="26"
                                        VerticalAlignment="Top" ToolTip="Zoom to this in the drawing"
                                        Command="{Binding DataContext.ZoomRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding OpId}" />
                            </Grid>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- selection summary -->
            <TextBlock Margin="14,8,14,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}">
                <Run Text="{Binding ChangeSet.AcceptedCount, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding ChangeSet.TotalCount, Mode=OneWay}"/><Run Text=" selected"/>
            </TextBlock>

            <!-- status line -->
            <TextBlock Text="{Binding StatusMessage}" Margin="14,8,14,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />

            <!-- ===== Action bar ===== -->
            <Border Padding="14,12" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Accept all" Style="{DynamicResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding AcceptAllCommand}" Padding="10,5" FontSize="12" />
                        <Button Content="Reject all" Style="{DynamicResource GhostButton}"
                                Command="{Binding RejectAllRowsCommand}" Padding="10,5" FontSize="12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Reject" Style="{DynamicResource GhostButton}" Margin="0,0,8,0"
                                Command="{Binding RejectCommand}" />
                        <Button Content="Accept &amp; apply" Style="{DynamicResource AccentButton}"
                                Command="{Binding AcceptCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- applied banner with inline undo -->
            <Border Padding="14,12" Background="#1A3FB950" CornerRadius="0,0,10,10"
                    Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓ Applied as one undo step" Foreground="{DynamicResource Brush.Ok}" VerticalAlignment="Center" />
                    <Button Content="Undo" Style="{DynamicResource LinkButton}" Margin="12,0,0,0"
                            Command="{Binding UndoCommand}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- rejected banner -->
            <Border Padding="14,10" Visibility="{Binding IsRejected, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Rejected - the drawing was never touched." Foreground="{DynamicResource Brush.TextFaint}" FontSize="12" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
