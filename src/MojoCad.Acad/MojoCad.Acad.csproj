<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MojoCad.Acad - the AutoCAD adapter. THE ONLY project that references the
    AutoCAD managed assemblies and touches the Database. Implements the Core
    ports: IAcadBridge (read), IChangePreviewer (transient preview),
    IChangeApplier (atomic commit).

    AutoCAD assemblies are provided by the running AutoCAD process, so the
    AutoCAD.NET package's runtime assets are EXCLUDED (equivalent to the classic
    <Private>false</Private>) - we compile against them but never copy them out.

    Package versions track the AutoCAD release per target framework:
      net8.0-windows -> AutoCAD 2025+  -> AutoCAD.NET 25.x
      net48          -> AutoCAD 2024   -> AutoCAD.NET 24.3.x  (also loads in 2021-2023)
    Adjust the versions to match the AutoCAD release you build for, or replace the
    PackageReference with HintPath <Reference>s to your local ObjectARX SDK / install.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <RootNamespace>MojoCad.Acad</RootNamespace>
    <AssemblyName>MojoCad.Acad</AssemblyName>
    <UseWPF>false</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MojoCad.Core\MojoCad.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="24.3.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
